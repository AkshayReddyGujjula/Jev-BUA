TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Required for TYPE_TEXT, mode memory and the collector. OpenAI-compatible helper;
# credentials stay server-side. The current configuration runs deepseek-v4.1-flash through
# the OpenCode Go endpoint with reasoning disabled. Any OpenAI-compatible provider works.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
TEXT_MODEL=deepseek-v4.1-flash
TEXT_MODEL_REASONING=none

# Task modes: off (default) | auto | a mode slug. auto matches an existing mode by keyword
# and asks the text model to create one for a durable new task class.
JEV_MODES=off
# Mode folders hold personal memory and live outside the repository by default.
# JEV_MODES_DIR=
