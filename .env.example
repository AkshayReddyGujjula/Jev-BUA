TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# A decision unanswered after this many seconds gets one duplicate request on a fresh
# connection; the first answer wins. 0 disables.
# JEV_DECIDE_HEDGE=1.0
# JEV_PREWARM=1               # open the decision connections while the tab opens
# JEV_KEEPALIVE_SECONDS=120   # idle lifetime of pooled model connections (httpx default 5)

# Required for TYPE_TEXT, mode memory and the collector. OpenAI-compatible helper;
# credentials stay server-side. The current configuration runs deepseek-v4.1-flash through
# the OpenCode Go endpoint with reasoning disabled. Any OpenAI-compatible provider works.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
TEXT_MODEL=deepseek-v4.1-flash
TEXT_MODEL_REASONING=none

# On-demand supervisor: consulted only when the loop is stuck (no-progress deadline, three
# dead actions in a row, or Jev choosing BLOCKED), never on the fast path. auto (default)
# uses the text-model endpoint above; off disables it. SUPERVISOR_* override the endpoint.
# JEV_SUPERVISOR=auto
# SUPERVISOR_MODEL=deepseek-v4.1-flash
# JEV_SUPERVISOR_LIMIT=2       # consults per run
# JEV_SUPERVISOR_TIMEOUT=8     # seconds per consult

# Parallel reviewer: the same endpoint watches every executed step off the critical path and
# turns an off-track verdict into a sub-goal; it also checks the final page before DONE.
# JEV_REVIEW=auto               # off disables it
# REVIEW_MODEL=                 # defaults to SUPERVISOR_MODEL / TEXT_MODEL
# JEV_REVIEW_LIMIT=12           # reviews per run
# JEV_REVIEW_TIMEOUT=6          # seconds per review
# JEV_REVIEW_DONE_LIMIT=2       # times a review may overturn DONE in one run
# JEV_LITERAL_MIN=0.6           # confidence to type a value quoted in the goal verbatim
# JEV_NAV_READ_TIMEOUT=3        # seconds to re-read a page that is mid-navigation

# Task modes: off (default) | auto | a mode slug. auto matches an existing mode by keyword
# and asks the text model to create one for a durable new task class.
JEV_MODES=off
# Mode folders hold personal memory and live outside the repository by default.
# JEV_MODES_DIR=

# Optional Browser Use Cloud browser backend. Paste this key into the ignored .env
# only if you choose to run `jev-cloud`; local `jev` never requires it.
# Key source: https://cloud.browser-use.com/settings?tab=api-keys
# BROWSER_USE_API_KEY=
# The annotated agents.env.example also lists every credential and its role.
