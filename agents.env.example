# AgentJevUltraFast credentials for local and optional Cloud Browser runs.
# The existing repo .env is the normal place to paste these values. To keep a
# separate file, copy this example to agents.env (also ignored by Git) and run
# the CLI with `uv run --env-file agents.env ...`.
# Paste keys only after the equals sign. Never paste keys into this example file,
# a command argument, a chat message, or a screenshot.

# 1. Browser Use Cloud API key from:
# https://cloud.browser-use.com/settings?tab=api-keys
# Required only for the opt-in `jev-cloud` command. It starts with bu_.
BROWSER_USE_API_KEY=

# 2. TypeSafe Jev key from your TypeSafe account.
# Required for Jev's operation and observed-element choices, local or cloud.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 3. Your text-model provider key. This is for form text, on-demand supervision,
# and review. Use the matching base URL and model for the provider of this key.
# The example below is OpenCode Go; replace all three settings together if you
# use a different OpenAI-compatible endpoint.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
TEXT_MODEL=deepseek-v4.1-flash
TEXT_MODEL_REASONING=none

# 4. Cloud Browser choices go on the jev-cloud command line: --proxy none|us,
# --timeout-seconds 120, and optionally --profile <Cloud profile ID>.
# Direct egress is the default; choose a proxy only when testing its effect.

# Keep Browser Use Cloud auto recharge OFF for a free-credits-only trial.
# Its spending cap is soft. Check your project balance before starting a run.
